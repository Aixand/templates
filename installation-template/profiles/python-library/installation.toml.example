schema = 1
profile = "python-library"
manifest = "pyproject.toml"

[python]
version = "{{PYTHON_VERSION}}"

[commands]
# Replace with actual checks/tests and include their tools in the locked dev group.
check = [["uv", "run", "--locked", "ruff", "check", "src", "tests"]]
test = [["uv", "run", "--locked", "python", "-m", "unittest", "discover", "-s", "tests", "-v"]]

[verification]
commands = [["{python}", "-I", "-c", "import {{IMPORT_NAME}}; {{LIBRARY_ASSERTION}}"]]
