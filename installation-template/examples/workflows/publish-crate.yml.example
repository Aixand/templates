# Install as .github/workflows/publish-crate.yml and configure crates.io
# ownership and Trusted Publishing for this filename and the crates-io environment.
# This example selects one public crate; coordinate dependent crate releases first.
name: Publish Cargo crate
on:
  push:
    tags: ['v*']
permissions:
  contents: read
concurrency:
  group: publish-crate-${{ github.repository }}
  cancel-in-progress: false
jobs:
  verify:
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@1af3b93b6815bc44a9784bd300feb67ff0d1eeb3 # v6.0.0
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@e797f83bcb11b83ae66e0230d6156d7c80228e7c # v6.0.0
        with:
          python-version: '3.11'
      - name: Install selected Rust toolchain
        shell: bash
        run: |
          rust_version=$(python -c 'import re,tomllib; v=tomllib.load(open("rust-toolchain.toml","rb"))["toolchain"]["channel"]; assert re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+",v); print(v)')
          rustup toolchain install "$rust_version" --profile minimal --component clippy --component rustfmt
      - name: Validate selected tag and source
        env:
          RELEASE_TAG: ${{ github.ref_name }}
        run: ./dev.sh release-check --version "$RELEASE_TAG"
      - run: ./dev.sh develop
      - run: ./dev.sh check
      - run: ./dev.sh test
      - run: ./dev.sh package --output dist/release
      - run: ./dev.sh verify --artifact dist/release --install
      - name: Bind verified package to clean release inputs
        env:
          RELEASE_TAG: ${{ github.ref_name }}
        run: ./dev.sh release-check --version "$RELEASE_TAG" --artifact dist/release
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: cargo-release
          path: dist/release/
          if-no-files-found: error
  publish:
    needs: verify
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    environment: crates-io
    permissions:
      contents: read
      id-token: write
    steps:
      - uses: actions/checkout@1af3b93b6815bc44a9784bd300feb67ff0d1eeb3 # v6.0.0
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - uses: actions/setup-python@e797f83bcb11b83ae66e0230d6156d7c80228e7c # v6.0.0
        with:
          python-version: '3.11'
      - name: Install selected Rust toolchain
        shell: bash
        run: |
          rust_version=$(python -c 'import re,tomllib; v=tomllib.load(open("rust-toolchain.toml","rb"))["toolchain"]["channel"]; assert re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+",v); print(v)')
          rustup toolchain install "$rust_version" --profile minimal
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2
        with:
          name: cargo-release
          path: dist/release
      - uses: rust-lang/crates-io-auth-action@c6f97d42243bad5fab37ca0427f495c86d5b1a18 # v1.0.5
        id: auth
      - name: Publish and confirm the selected crate
        env:
          CARGO_REGISTRY_TOKEN: ${{ steps.auth.outputs.token }}
          RELEASE_TAG: ${{ github.ref_name }}
        run: python -B scripts/dev/publish_crate.py --project . --artifact dist/release --tag "$RELEASE_TAG" --registry crates-io
