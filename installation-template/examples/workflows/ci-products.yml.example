# Adopt only the native targets declared and qualified by the project.
name: Product artifacts
on:
  pull_request:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  products:
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-24.04, windows-2022, macos-14]
    env:
      PYTHONDONTWRITEBYTECODE: '1'
      UV_LINK_MODE: copy
    steps:
      - uses: actions/checkout@1af3b93b6815bc44a9784bd300feb67ff0d1eeb3 # v6.0.0
        with:
          persist-credentials: false
      - uses: actions/setup-python@e797f83bcb11b83ae66e0230d6156d7c80228e7c # v6.0.0
        with:
          python-version: '3.14'
      - uses: astral-sh/setup-uv@eb1897b8dc4b5d5bfe39a428a8f2304605e0983c # v7.0.0
        with:
          version: '0.12.7'
      - run: rustup toolchain install 1.98.0 --profile minimal
      - name: Verify Unix product and handoff
        if: runner.os != 'Windows'
        run: |
          ./dev.sh develop
          ./dev.sh check
          ./dev.sh test
          ./dev.sh package --output dist/release
          ./dev.sh verify --artifact dist/release --install --report dist/verification.json
          ./dev.sh export-release --artifact dist/release --report dist/verification.json --output dist/handoff
      - name: Verify native Windows product and handoff
        if: runner.os == 'Windows'
        shell: pwsh
        run: |
          ./dev.ps1 develop
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          ./dev.ps1 check
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          ./dev.ps1 test
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          ./dev.ps1 package --output dist/release
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          ./dev.ps1 verify --artifact dist/release --install --report dist/verification.json
          if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
          ./dev.ps1 export-release --artifact dist/release --report dist/verification.json --output dist/handoff
          exit $LASTEXITCODE
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: product-${{ runner.os }}-${{ runner.arch }}
          path: dist/handoff/
          if-no-files-found: error
