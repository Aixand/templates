# Copy to .github/dependabot.yml and match entries to actual manifest locations.
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly
    open-pull-requests-limit: 5

  # Enable and adjust only the ecosystems used by the project:
  # - package-ecosystem: pip
  #   directory: /
  #   schedule:
  #     interval: weekly
  # - package-ecosystem: cargo
  #   directory: /
  #   schedule:
  #     interval: weekly
  # - package-ecosystem: npm
  #   directory: /web
  #   schedule:
  #     interval: weekly

# Inline Gitleaks version/checksum pins need manual release review.
# Bot PRs are subject to the same DCO policy. See the template setup guide:
# https://github.com/Aixand/open-source-template/blob/main/SETUP.md
